generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  watchlistItems WatchlistItem[]
  snapshots      UserSnapshot[]

  @@map("users")
}

model Symbol {
  id       String @id @default(cuid())
  ticker   String @unique
  name     String
  exchange String @default("US")

  watchlistItems  WatchlistItem[]
  snapshotSymbols SnapshotSymbol[]
  marketBars      MarketBar[]
  newsItems       NewsItem[]

  @@map("symbols")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  symbolId  String   @map("symbol_id")
  addedAt   DateTime @default(now()) @map("added_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([userId, symbolId])
  @@index([userId])
  @@map("watchlist_items")
}

model UserSnapshot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  checkedAt DateTime @default(now()) @map("checked_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbols SnapshotSymbol[]

  @@index([userId, checkedAt(sort: Desc)])
  @@map("user_snapshots")
}

model SnapshotSymbol {
  id              String @id @default(cuid())
  snapshotId      String @map("snapshot_id")
  symbolId        String @map("symbol_id")
  price           Decimal @db.Decimal(18, 6)
  volume          BigInt
  avgVolume20d    Decimal @map("avg_volume_20d") @db.Decimal(18, 2)
  sentimentScore  Decimal @map("sentiment_score") @db.Decimal(8, 4)
  newsCount       Int     @map("news_count")
  volatilityAtr   Decimal @map("volatility_atr") @db.Decimal(18, 6)

  snapshot UserSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  symbol   Symbol       @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, symbolId])
  @@map("snapshot_symbols")
}

model MarketBar {
  id        String   @id @default(cuid())
  symbolId  String   @map("symbol_id")
  barDate   DateTime @map("bar_date") @db.Date
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt
  fetchedAt DateTime @default(now()) @map("fetched_at")

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, barDate])
  @@index([symbolId, barDate(sort: Desc)])
  @@map("market_bars")
}

model NewsItem {
  id          String   @id @default(cuid())
  symbolId    String   @map("symbol_id")
  externalId  String   @unique @map("external_id")
  publishedAt DateTime @map("published_at")
  title       String
  source      String
  url         String
  sentiment   Decimal  @db.Decimal(8, 4)
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@index([symbolId, publishedAt(sort: Desc)])
  @@map("news_items")
}
